{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/waitlist-landing-page", "destination": "/landing", "permanent": true }
  ],
  "rewrites": [
    { "source": "/waitlist", "destination": "/landing" },
    { "source": "/lotus", "destination": "/landing" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" }
      ]
    }
  ]
}
